---
import { generateBreadcrumbJsonLd } from '../utils/breadcrumbUtils';

interface Props {
	items: Array<{ label: string; href?: string }>;
	/**
	 * If true, generates and returns JSON-LD structured data for SEO
	 * The JSON-LD script tag should be placed in the <head> section
	 */
	generateJsonLd?: boolean;
	/**
	 * Base URL for generating absolute URLs in JSON-LD
	 * Defaults to Astro.url.origin
	 */
	baseUrl?: string;
}

const { items, generateJsonLd = false, baseUrl = Astro.url.origin } = Astro.props;

// Generate JSON-LD if requested
const jsonLd = generateJsonLd && items && items.length > 0
	? generateBreadcrumbJsonLd(items, baseUrl)
	: null;
---

{items && items.length > 0 && (
	<nav class="breadcrumb-nav" aria-label="Breadcrumb">
		<ol class="breadcrumb-list flex flex-wrap items-center gap-2 text-sm">
			{items.map((item, index) => {
				const isLast = index === items.length - 1;
				const isLink = item.href && !isLast;
				
				return (
					<li class="breadcrumb-item flex items-center gap-2">
						{isLink ? (
							<button 
								type="button"
								onclick={`window.location.href='${item.href}'`}
								class="rounded transition-all duration-200 ease-in-out cursor-pointer font-normal focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-base-100 bg-gray-300 text-black border border-gray-400 hover:bg-transparent hover:text-gray-300 hover:border-gray-400 active:scale-95 active:opacity-90 px-2 py-1 text-sm text-center flex items-center gap-2 justify-center whitespace-nowrap max-[320px]:!px-1.5 max-[320px]:!py-0.5 max-[320px]:!text-xs"
							>
								{item.label}
							</button>
						) : (
							<span class="breadcrumb-current text-white font-semibold" aria-current="page">
								{item.label}
							</span>
						)}
						{!isLast && (
							<svg 
								class="breadcrumb-separator text-secondary/50" 
								aria-hidden="true" 
								viewBox="0 0 16 16" 
								fill="currentColor"
								width="16"
								height="16"
							>
								<path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0L10.94 8a.75.75 0 0 1 0 1.06l-3.66 3.78a.75.75 0 1 1-1.06-1.06L9.38 8.5 6.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
							</svg>
						)}
					</li>
				);
			})}
		</ol>
	</nav>
)}

{jsonLd && (
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
