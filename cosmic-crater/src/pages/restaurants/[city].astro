---
import '@/components/index.css';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SSRAppWrapper from '../../components/SSRAppWrapper.jsx';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ResponsiveFlexRow from '../../components/common/ResponsiveFlexRow.jsx';
import Link from '../../components/common/Link.astro';
import LikeDisplay from '../../components/common/LikeDisplay.astro';
import SSRRestaurantCarousel from '../../components/restaurants/SSRRestaurantCarousel.jsx';
import { SITE_TITLE } from '../../consts';

const { city } = Astro.params;

// Always show SSR initially - client will check auth and mount SPA if needed
const showSpa = false;

let restaurants = [];
let cityName = 'this area';

// Always fetch restaurants for SSR (they'll be replaced if SPA mounts)
const apiBase = Astro.url.origin;
const res = await fetch(
	`${apiBase}/api/restaurants-by-city?city_slug=${encodeURIComponent(city)}`,
	{
		method: 'GET',
		headers: { accept: 'application/json' }
	}
);

if (!res.ok) {
	throw new Error(`Failed to load restaurants for city: ${res.status}`);
}

restaurants = await res.json();
cityName = restaurants[0]?.city_name ?? 'this area';

const slugify = (name) =>
	name
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');

// Group restaurants by category
const grouped = restaurants.reduce((acc, restaurant) => {
	const category = restaurant.category || 'Other';
	if (!acc[category]) {
		acc[category] = [];
	}
	acc[category].push(restaurant);
	return acc;
}, {});

// Helper function to generate category URL
const getCategoryUrl = (categoryName) => {
	if (!categoryName) return null;
	const categorySlug = slugify(categoryName);
	return `/restaurants/${city}/categories/${categorySlug}`;
};

// Breadcrumb structured data
const breadcrumbData = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: Astro.url.origin + '/'
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: cityName,
			item: Astro.url.origin + `/restaurants/${city}`
		}
	]
};
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Food Delivery in ${cityName}, CA | Order Online | RivCoDelivery`}
			description={`Order food delivery from top restaurants in ${cityName}, California. Browse menus, compare prices, and get fast delivery. Easy online ordering with RivCoDelivery.`}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
		<style>
			#ssr-content main {
				max-width: 100%;
				width: 100%;
			}
		</style>
	</head>
	<body>
		<Header />
		<!-- SSR content - visible by default for SEO, hidden if user is logged in -->
		<div id="ssr-content">
			<main class="mx-auto px-4">
				<h1 class="mb-3 text-2xl font-semibold text-white">Restaurants in {cityName}, California</h1>
				
				<p class="text-base text-base-content/70 mb-6">
					{SITE_TITLE} fulfills restaurant delivery orders in {cityName} after we receive payment for your order. You can pay for your order through Zelle, Apple Cash, or credit card, and your food will be delivered as soon as possible or at the delivery time you specify.
				</p>
				
				<div class="py-4 bg-base-100 rounded-xl mb-6">
					<div class="px-4">
						<Breadcrumb items={[
							{ label: 'Home', href: '/' },
							{ label: cityName }
						]} />
					</div>
				</div>

				{restaurants.length === 0 ? (
					<div class="card bg-base-100 shadow-md">
						<div class="card-body">
							<p class="text-base-content">No restaurants found in this city yet.</p>
						</div>
					</div>
				) : (
					Object.keys(grouped).map((category) => {
						const categoryUrl = getCategoryUrl(category);
						return (
							<div class="mb-6" key={category}>
								<div class="py-4 bg-gray-800 rounded-xl">
									{categoryUrl ? (
										<h2 class="text-2xl font-bold mb-4 text-primary px-4">
											<Link 
												href={categoryUrl}
												className="link link-hover text-primary"
											>
												{category} delivery in {cityName}
											</Link>
										</h2>
									) : (
										<h2 class="text-2xl font-bold mb-4 text-primary px-4">{category} delivery in {cityName}</h2>
									)}
									<SSRRestaurantCarousel 
										restaurants={grouped[category]} 
										city={city}
										categoryIndex={Object.keys(grouped).indexOf(category)}
										categoryUrl={categoryUrl}
										client:only="react"
									/>
								</div>
							</div>
						);
					})
				)}
			</main>
		</div>
		
		<!-- SPA container - wrapper checks auth before rendering App -->
		<div id="spa-container" style="display: none;">
			<SSRAppWrapper client:only="react" />
		</div>
		
		<Footer />
		
		<!-- Client-side auth check -->
		<script>
			function checkAuthAndShowSPA() {
				const profile = localStorage.getItem('profile');
				const ssrContent = document.getElementById('ssr-content');
				const spaContainer = document.getElementById('spa-container');
				
				// SSR content is visible by default (good for SEO crawlers)
				// Only hide it if user is definitely logged in
				
				if (profile) {
					// User might be logged in - verify session first
					// Hide SSR and show SPA immediately to prevent flicker
					if (ssrContent) ssrContent.style.display = 'none';
					if (spaContainer) spaContainer.style.display = 'block';
					
					// Then verify session
					fetch('/api/session', {
						credentials: 'include'
					})
					.then(res => {
						if (res.status !== 200) {
							// Session invalid - show SSR (user sees SSR content)
							if (ssrContent) ssrContent.style.display = 'block';
							if (spaContainer) spaContainer.style.display = 'none';
						}
						// If session is valid, SSR stays hidden, SPA stays visible
					})
					.catch(err => {
						console.error('Error checking session:', err);
						// On error, show SSR (safer default)
						if (ssrContent) ssrContent.style.display = 'block';
						if (spaContainer) spaContainer.style.display = 'none';
					});
				} else {
					// No profile - SSR content is already visible (default state)
					// Just make sure SPA is hidden
					if (spaContainer) spaContainer.style.display = 'none';
					// SSR content doesn't need to be explicitly shown - it's visible by default
				}
			}
			
			// Check immediately on page load (before DOM fully renders)
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', checkAuthAndShowSPA);
			} else {
				checkAuthAndShowSPA();
			}
			
			// Listen for custom event dispatched after login
			window.addEventListener('profile-changed', () => {
				checkAuthAndShowSPA();
			});
		</script>
	</body>
</html>


