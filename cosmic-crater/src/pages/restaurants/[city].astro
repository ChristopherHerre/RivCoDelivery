---
import '@/components/index.css';
import '@/components/index-ios.css';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SSRAppWrapper from '../../components/SSRAppWrapper.jsx';

const { city } = Astro.params;

// Always show SSR initially - client will check auth and mount SPA if needed
const showSpa = false;

let restaurants = [];
let cityName = 'this area';

// Always fetch restaurants for SSR (they'll be replaced if SPA mounts)
const apiBase = Astro.url.origin;
const res = await fetch(
	`${apiBase}/api/restaurants-by-city?city_slug=${encodeURIComponent(city)}`,
	{
		method: 'GET',
		headers: { accept: 'application/json' }
	}
);

if (!res.ok) {
	throw new Error(`Failed to load restaurants for city: ${res.status}`);
}

restaurants = await res.json();
cityName = restaurants[0]?.city_name ?? 'this area';

const slugify = (name) =>
	name
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Restaurants in ${cityName} | RivCoDelivery`}
			description={`Discover restaurants in ${cityName} available for delivery with RivCoDelivery.`}
		/>
		<style>
			#ssr-content main {
				max-width: 100%;
				width: 100%;
			}
		</style>
	</head>
	<body>
		<Header />
		<!-- SSR content - visible by default for SEO, hidden if user is logged in -->
		<div id="ssr-content">
			<main class="mx-auto px-4 py-5">
				<h1 class="mb-3 text-2xl font-semibold">Restaurants in {cityName}</h1>

				{restaurants.length === 0 ? (
					<p class="text-gray-600">No restaurants found in this city yet.</p>
				) : (
					<div class="row flex flex-wrap -mx-3">
						{restaurants.map((r) => {
							const slug = slugify(r.name);
							return (
								<div class="w-full md:w-1/2 px-3 mb-3" key={r.id}>
									<article class="border border-gray-600 rounded-lg shadow-sm bg-gray-900 h-full flex flex-col hover:shadow-md transition-shadow">
										<div class="p-4 flex-1 flex flex-col">
											<h2 class="text-lg font-semibold mb-2">
												<a href={`/restaurants/${city}/${r.id}-${slug}`} class="text-white no-underline hover:text-blue-400 transition-colors">
													{r.name}
												</a>
											</h2>
											<p class="mb-1 text-base">
												<strong class="font-semibold text-white">{r.category}</strong>
											</p>
											<p class="mb-2 text-base text-gray-300">{r.address}</p>
											<div class="mt-auto">
												<a
													href={`/restaurants/${city}/${r.id}-${slug}`}
													class="inline-block px-3 py-1.5 bg-blue-600 text-white text-sm font-normal rounded hover:bg-blue-700 active:bg-blue-800 transition-colors no-underline"
												>
													View menu
												</a>
											</div>
										</div>
									</article>
								</div>
							);
						})}
					</div>
				)}
			</main>
		</div>
		
		<!-- SPA container - wrapper checks auth before rendering App -->
		<div id="spa-container" style="display: none;">
			<SSRAppWrapper client:only="react" />
		</div>
		
		<Footer />
		
		<!-- Client-side auth check -->
		<script>
			function checkAuthAndShowSPA() {
				const profile = localStorage.getItem('profile');
				const ssrContent = document.getElementById('ssr-content');
				const spaContainer = document.getElementById('spa-container');
				
				// SSR content is visible by default (good for SEO crawlers)
				// Only hide it if user is definitely logged in
				
				if (profile) {
					// User might be logged in - verify session first
					// Hide SSR and show SPA immediately to prevent flicker
					if (ssrContent) ssrContent.style.display = 'none';
					if (spaContainer) spaContainer.style.display = 'block';
					
					// Then verify session
					fetch('/api/session', {
						credentials: 'include'
					})
					.then(res => {
						if (res.status !== 200) {
							// Session invalid - show SSR (user sees SSR content)
							if (ssrContent) ssrContent.style.display = 'block';
							if (spaContainer) spaContainer.style.display = 'none';
						}
						// If session is valid, SSR stays hidden, SPA stays visible
					})
					.catch(err => {
						console.error('Error checking session:', err);
						// On error, show SSR (safer default)
						if (ssrContent) ssrContent.style.display = 'block';
						if (spaContainer) spaContainer.style.display = 'none';
					});
				} else {
					// No profile - SSR content is already visible (default state)
					// Just make sure SPA is hidden
					if (spaContainer) spaContainer.style.display = 'none';
					// SSR content doesn't need to be explicitly shown - it's visible by default
				}
			}
			
			// Check immediately on page load (before DOM fully renders)
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', checkAuthAndShowSPA);
			} else {
				checkAuthAndShowSPA();
			}
			
			// Listen for custom event dispatched after login
			window.addEventListener('profile-changed', () => {
				checkAuthAndShowSPA();
			});
		</script>
	</body>
</html>


