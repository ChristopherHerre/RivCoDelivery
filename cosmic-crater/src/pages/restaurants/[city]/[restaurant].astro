---
import "bootstrap/dist/css/bootstrap.min.css";
import '@/components/index.css';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import App from '@/components/App.jsx';
import ReactDOM from 'react-dom-client'
import {createPopper} from '@popperjs/core';
import { checkAuthentication } from '../utils/authCheck';

const { city, restaurant } = Astro.params;

// Always show SSR initially - client will check auth and mount SPA if needed
const showSpa = false;

const restaurantId = Number((restaurant ?? '').split('-')[0]);
if (!restaurantId || Number.isNaN(restaurantId)) {
	throw new Error('Invalid restaurant id');
}

let r = null;
let grouped = {};

// Always fetch restaurant data for SSR (they'll be replaced if SPA mounts)
const apiBase = Astro.url.origin;
const restaurantRes = await fetch(`${apiBase}/api/public/restaurants/${restaurantId}`, {
	method: 'GET',
	headers: { accept: 'application/json' }
});

if (!restaurantRes.ok) {
	throw new Error(`Failed to load restaurant: ${restaurantRes.status}`);
}

r = await restaurantRes.json();

if (r.city_slug && r.city_slug !== city) {
	throw new Error('Restaurant does not belong to this city');
}

const menuRes = await fetch(
	`${apiBase}/api/public/menu-items?restaurant_id=${restaurantId}`,
	{
		method: 'GET',
		headers: { accept: 'application/json' }
	}
);

if (!menuRes.ok) {
	throw new Error(`Failed to load menu items: ${menuRes.status}`);
}

const menuItems = await menuRes.json();

grouped = menuItems.reduce((acc, item) => {
	const key = item.category || 'Menu';
	if (!acc[key]) acc[key] = [];
	acc[key].push(item);
	return acc;
}, {});
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={r ? `${r.name} menu in ${r.city_name} | RivCoDelivery` : `Restaurant Menu | RivCoDelivery`}
			description={r ? `Browse the menu for ${r.name} in ${r.city_name}. Order delivery with RivCoDelivery.` : `Browse restaurant menu and order delivery with RivCoDelivery.`}
		/>
		{r && (
			<script type="application/ld+json">
				{JSON.stringify({
					'@context': 'https://schema.org',
					'@type': 'Restaurant',
					name: r.name,
					address: r.address,
					geo: {
						'@type': 'GeoCoordinates',
						latitude: r.latitude,
						longitude: r.longitude
					}
				})}
			</script>
		)}
	</head>
	<body>
		<Header />
		<!-- SSR content - will be hidden if user is logged in -->
		{r && (
			<div id="ssr-content">
				
				<main class="container mx-auto px-4 py-5 max-w-6xl">
					<header class="mb-4">
						<h1 class="mb-1 text-2xl font-semibold">{r.name}</h1>
						<p class="mb-1 text-base">
							<strong class="font-semibold">{r.category}</strong>
						</p>
						<p class="mb-1 text-base text-gray-700">{r.address}</p>
						{r.city_name && <p class="text-gray-600 mb-3 text-base">{r.city_name}</p>}

						<a href={`/?restaurant=${r.id}&view=menu`} class="inline-block px-4 py-2 bg-blue-600 text-white font-normal rounded hover:bg-blue-700 active:bg-blue-800 transition-colors no-underline">
							Order from this restaurant
						</a>
					</header>

					{Object.entries(grouped).map(([category, items]) => (
						<section class="mb-4" key={category}>
							<h2 class="text-xl font-semibold mb-2">{category}</h2>
							<div class="list-none p-0 m-0">
								{items.map((item) => (
									<article
										class="border border-gray-300 border-t-0 first:border-t first:rounded-t last:rounded-b bg-white flex justify-between items-start px-4 py-3 hover:bg-gray-50 transition-colors"
										key={item.id}
									>
										<div class="flex-1">
											<h3 class="text-base font-semibold mb-1">{item.name}</h3>
											{item.size_display_name && (
												<p class="text-sm text-gray-600 mb-0">{item.size_display_name}</p>
											)}
										</div>
										<div class="ml-3">
											<span class="font-bold text-base">
												${Number(item.price).toFixed(2)}
											</span>
										</div>
									</article>
								))}
							</div>
						</section>
					))}
				</main>
			</div>
		)}
		

		<!-- SPA container - hidden initially, shown if user is logged in -->
		<div id="spa-container" style="display: none;">
			<App client:only="react" />
		</div>
		
		<Footer />
		
		<!-- Client-side auth check -->
		<script>
			function checkAuthAndShowSPA() {
				// Check if user is authenticated via localStorage (same as SPA does)
				const profile = localStorage.getItem('profile');
				if (profile) {
					// User is logged in - verify session is still valid
					fetch('/api/session', {
						credentials: 'include'
					})
					.then(res => {
						if (res.status === 200) {
							// Session is valid - hide SSR, show SPA
							const ssrContent = document.getElementById('ssr-content');
							const spaContainer = document.getElementById('spa-container');
							if (ssrContent) ssrContent.style.display = 'none';
							if (spaContainer) spaContainer.style.display = 'block';
						}
					})
					.catch(err => {
						console.error('Error checking session:', err);
					});
				} else {
					// User is not logged in - show SSR, hide SPA
					const ssrContent = document.getElementById('ssr-content');
					const spaContainer = document.getElementById('spa-container');
					if (ssrContent) ssrContent.style.display = 'block';
					if (spaContainer) spaContainer.style.display = 'none';
				}
			}
			
			// Check on initial page load
			checkAuthAndShowSPA();
			
			// Listen for custom event dispatched after login
			window.addEventListener('profile-changed', () => {
				checkAuthAndShowSPA();
			});
		</script>
	</body>
</html>


