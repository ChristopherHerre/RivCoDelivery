---
import '@/components/index.css';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SSRAppWrapper from '@/components/SSRAppWrapper.jsx';
import OrderButtonWithAuth from '@/components/users/nav/OrderButtonWithAuth.jsx';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ResponsiveFlexRow from '@/components/common/ResponsiveFlexRow.jsx';
import LikeDisplay from '@/components/common/LikeDisplay.astro';

const { city, restaurant } = Astro.params;

// Always show SSR initially - client will check auth and mount SPA if needed
const showSpa = false;

const restaurantId = Number((restaurant ?? '').split('-')[0]);
if (!restaurantId || Number.isNaN(restaurantId)) {
	throw new Error('Invalid restaurant id');
}

let r = null;
let grouped = {};

// Always fetch restaurant data for SSR (they'll be replaced if SPA mounts)
const apiBase = Astro.url.origin;
const restaurantRes = await fetch(`${apiBase}/api/public/restaurants/${restaurantId}`, {
	method: 'GET',
	headers: { accept: 'application/json' }
});

if (!restaurantRes.ok) {
	throw new Error(`Failed to load restaurant: ${restaurantRes.status}`);
}

r = await restaurantRes.json();

if (r.city_slug && r.city_slug !== city) {
	throw new Error('Restaurant does not belong to this city');
}

const menuRes = await fetch(
	`${apiBase}/api/restaurants2/${restaurantId}/menu`,
	{
		method: 'GET',
		headers: { accept: 'application/json' }
	}
);

if (!menuRes.ok) {
	throw new Error(`Failed to load menu items: ${menuRes.status}`);
}

const menuItems = await menuRes.json();

grouped = menuItems.reduce((acc, item) => {
	const key = item.category || 'Menu';
	if (!acc[key]) acc[key] = [];
	acc[key].push(item);
	return acc;
}, {});
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={r ? `${r.name} Delivery in ${r.city_name}, CA | Order ${r.category || 'Food'} Online | RivCoDelivery` : `Restaurant Menu | RivCoDelivery`}
			description={r ? `Order ${r.category ? r.category.toLowerCase() : 'food'} delivery from ${r.name} in ${r.city_name}, California. Browse full menu, customize your order, and get fast delivery. Easy online ordering with RivCoDelivery.` : `Browse restaurant menu and order delivery with RivCoDelivery.`}
		/>
		{r && (
			<script type="application/ld+json">
				{JSON.stringify({
					'@context': 'https://schema.org',
					'@type': 'Restaurant',
					name: r.name,
					address: {
						'@type': 'PostalAddress',
						streetAddress: r.address,
						addressLocality: r.city_name || '',
						addressRegion: r.address.match(/,\s*([A-Z]{2})\s*\d/)?.[1] || '',
						addressCountry: 'US'
					},
					geo: {
						'@type': 'GeoCoordinates',
						latitude: r.latitude,
						longitude: r.longitude
					},
					servesCuisine: r.category,
					url: `${Astro.url.origin}/restaurants/${city}/${restaurant}`,
					priceRange: '$'
				})}
			</script>
		)}
		<style>
			#ssr-content main {
				max-width: 100%;
				width: 100%;
			}
		</style>
	</head>
	<body>
		<Header />
		<!-- SSR content - visible by default for SEO, hidden if user is logged in -->
		{r && (
			<div id="ssr-content">
				<main class="mx-auto">
					<Breadcrumb items={[
						{ label: 'Home', href: '/' },
						{ label: r.city_name || city, href: `/restaurants/${city}` },
						{ label: r.name }
					]} />
					<ResponsiveFlexRow margin="mb-6" align="stretch" variant="restaurant" client:only="react">
						<div class="flex-1 flex flex-col">
							<h1 class="mb-2 text-2xl font-semibold text-white">{r.name} Menu</h1>
							<p class="mb-1 text-base">
								<strong class="font-semibold text-white">{r.category}</strong>
							</p>
							<p class="mb-1 text-base text-white/90">{r.address}</p>
							
						</div>
						<div class="flex items-center max-lg:w-full">
							<OrderButtonWithAuth restaurantId={r.id} client:only="react" />
						</div>
					</ResponsiveFlexRow>

					{Object.entries(grouped).map(([category, items]) => {
						const slugify = (name) => {
							if (!name) return '';
							return name
								.toLowerCase()
								.replace(/[^a-z0-9]+/g, '-')
								.replace(/(^-|-$)/g, '');
						};
						return (
							<section class="mb-6" key={category}>
								<h2 class="text-xl font-semibold mb-3 text-gray-900">{category}</h2>
								<div class="flex flex-wrap -mx-3">
									{items.map((item) => {
										const itemSlug = slugify(item.name);
										return (
											<div class="w-full md:w-1/2 px-3 mb-3" key={item.id}>
												<ResponsiveFlexRow card vertical align="stretch" variant="menu">
													<div class="flex-1 flex flex-col">
														<h3 class="text-lg font-semibold mb-2">
															<a 
																href={`/restaurants/${city}/${restaurant}/menu/${itemSlug}-${item.id}`}
																class="text-white no-underline hover:text-blue-400 text-left bg-transparent border-none p-0 cursor-pointer transition-colors"
															>
																{item.name}
															</a>
														</h3>
														{item.category && (
															<p class="text-sm text-white/80 mb-2">{item.category}</p>
														)}
														{item.size_display_name && (
															<p class="text-sm text-white/80 mb-2">{item.size_display_name}</p>
														)}
														<ResponsiveFlexRow borderTop margin="mt-auto" variant="nested">
															<span class="font-bold text-lg text-white">
																${Number(item.price).toFixed(2)}
															</span>
															<div class="flex items-center gap-2">
																<a 
																	href={`/restaurants/${city}/${restaurant}/menu/${itemSlug}-${item.id}`}
																	class="inline-block px-5 py-2.5 bg-blue-600 text-white text-base font-normal rounded hover:bg-blue-700 active:bg-blue-800 transition-colors no-underline cursor-pointer max-lg:w-full max-lg:text-center"
																>
																	View details
																</a>
																<LikeDisplay itemId={item.id} itemType="menu-item" likes={item.likes || 0} />
															</div>
														</ResponsiveFlexRow>
													</div>
												</ResponsiveFlexRow>
											</div>
										);
									})}
								</div>
							</section>
						);
					})}
				</main>
			</div>
		)}
		

		<!-- SPA container - wrapper checks auth before rendering App -->
		<div id="spa-container" style="display: none;">
			<SSRAppWrapper client:only="react" />
		</div>
		
		<Footer />
		
		<!-- Client-side auth check -->
		<script>
			// Error message state
			let errorMessage = null;
			let errorTimeout = null;
			
			// Function to show error message
			function showErrorMessage(message) {
				console.log('Showing error message:', message); // Debug log
				
				// Clear existing timeout
				if (errorTimeout) {
					clearTimeout(errorTimeout);
				}
				
				errorMessage = message;
				
				// Remove existing error message if any
				const existingError = document.getElementById('ssr-error-message');
				if (existingError) {
					existingError.remove();
				}
				
				// Create error message element
				const errorDiv = document.createElement('div');
				errorDiv.id = 'ssr-error-message';
				errorDiv.className = 'bg-red-50 border-l-4 border-red-500 p-4 mb-4';
				errorDiv.innerHTML = `
					<div class="flex items-center justify-between">
						<p class="text-red-700 font-medium">${message}</p>
						<button
							onclick="document.getElementById('ssr-error-message').remove(); errorMessage = null;"
							class="text-red-500 hover:text-red-700 ml-4 text-xl font-bold cursor-pointer"
							aria-label="Dismiss error"
						>
							×
						</button>
					</div>
				`;
				
				// Insert error message at the top of the main content
				const ssrContent = document.getElementById('ssr-content');
				if (ssrContent) {
					const main = ssrContent.querySelector('main');
					if (main) {
						main.insertBefore(errorDiv, main.firstChild);
					} else {
						ssrContent.insertBefore(errorDiv, ssrContent.firstChild);
					}
				} else {
					console.error('ssr-content not found');
				}
				
				// Auto-dismiss after 5 seconds
				errorTimeout = setTimeout(() => {
					if (errorDiv && errorDiv.parentNode) {
						errorDiv.remove();
						errorMessage = null;
					}
				}, 5000);
			}
			
			// Intercept fetch requests to catch 429 errors
			const originalFetch = window.fetch;
			window.fetch = async function(...args) {
				try {
					const response = await originalFetch.apply(this, args);
					// Clone the response so we can read it without consuming it
					if (response.status === 429) {
						const clonedResponse = response.clone();
						try {
							const errorData = await clonedResponse.json();
							const errorMsg = errorData.message || errorData.error || 'Too many requests. Please wait a moment and try again.';
							showErrorMessage(errorMsg);
						} catch (e) {
							// If JSON parsing fails, use default message
							showErrorMessage('Too many requests. Please wait a moment and try again.');
						}
					}
					return response;
				} catch (error) {
					throw error;
				}
			};
			
			// Set up global error handler for React components to use
			window.handle429Error = function(errorMsg) {
				showErrorMessage(errorMsg);
			};
			
			// Also listen for unhandled promise rejections that might be 429 errors
			window.addEventListener('unhandledrejection', function(event) {
				if (event.reason?.response?.status === 429) {
					const errorMsg = event.reason.response?.data?.message || 
					                 event.reason.response?.data?.error || 
					                 'Too many requests. Please wait a moment and try again.';
					showErrorMessage(errorMsg);
				}
			});
			
			function checkAuthAndShowSPA() {
				const profile = localStorage.getItem('profile');
				const ssrContent = document.getElementById('ssr-content');
				const spaContainer = document.getElementById('spa-container');
				
				// SSR content is visible by default (good for SEO crawlers)
				// Only hide it if user is definitely logged in
				
				if (profile) {
					// User might be logged in - verify session first
					// Hide SSR and show SPA immediately to prevent flicker
					if (ssrContent) ssrContent.style.display = 'none';
					if (spaContainer) spaContainer.style.display = 'block';
					
					// Then verify session
					fetch('/api/session', {
						credentials: 'include'
					})
					.then(res => {
						if (res.status !== 200) {
							// Session invalid - show SSR (user sees SSR content)
							if (ssrContent) ssrContent.style.display = 'block';
							if (spaContainer) spaContainer.style.display = 'none';
						}
						// If session is valid, SSR stays hidden, SPA stays visible
					})
					.catch(err => {
						console.error('Error checking session:', err);
						// On error, show SSR (safer default)
						if (ssrContent) ssrContent.style.display = 'block';
						if (spaContainer) spaContainer.style.display = 'none';
					});
				} else {
					// No profile - SSR content is already visible (default state)
					// Just make sure SPA is hidden
					if (spaContainer) spaContainer.style.display = 'none';
					// SSR content doesn't need to be explicitly shown - it's visible by default
				}
			}
			
			// Check immediately on page load (before DOM fully renders)
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', checkAuthAndShowSPA);
			} else {
				checkAuthAndShowSPA();
			}
			
			// Listen for custom event dispatched after login
			window.addEventListener('profile-changed', () => {
				checkAuthAndShowSPA();
			});
		</script>
	</body>
</html>


