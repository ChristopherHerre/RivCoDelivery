---
import '../components/index.css'
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SSRAppWrapper from '../components/SSRAppWrapper.jsx';
import ResponsiveFlexRow from '../components/common/ResponsiveFlexRow.jsx';
import { SITE_TITLE } from '../consts';

// Always show SSR initially - client will check auth and mount SPA if needed
const showSpa = false;

let cities = [];
// Always fetch cities for SSR (they'll be replaced if SPA mounts)
const apiBase = Astro.url.origin;
const res = await fetch(`${apiBase}/api/restaurant-cities`, {
	method: 'GET',
	headers: { accept: 'application/json' }
});

if (!res.ok) {
	throw new Error(`Failed to load restaurant cities: ${res.status}`);
}

cities = await res.json();

// Organization structured data for homepage
const organizationData = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': Astro.url.origin,
	name: SITE_TITLE,
	description: 'Food delivery service in Riverside County, California',
	url: Astro.url.origin,
	address: {
		'@type': 'PostalAddress',
		addressRegion: 'CA',
		addressCountry: 'US'
	},
	areaServed: {
		'@type': 'State',
		name: 'California'
	},
	sameAs: [
		'https://www.linkedin.com/in/christopher-herre-04a59511a/',
		'https://github.com/ChristopherHerre/RivCoDelivery'
	]
};

// WebSite structured data
const websiteData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: Astro.url.origin,
	potentialAction: {
		'@type': 'SearchAction',
		target: {
			'@type': 'EntryPoint',
			urlTemplate: `${Astro.url.origin}/restaurants/{search_term_string}`
		},
		'query-input': 'required name=search_term_string'
	}
};
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Food Delivery in Riverside County, CA | Order Online | ${SITE_TITLE}`}
			description={`Order food delivery from top restaurants in Riverside County, California. Fast delivery, easy online ordering. Browse menus by city and place your order today with ${SITE_TITLE}.`}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(organizationData)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteData)} />
	</head>
	<body>
		<Header />
		<!-- SSR content - visible by default for SEO, hidden if user is logged in -->
		<div id="ssr-content">
			<main class="mx-auto">
				<header class="mb-6">
					<h1 class="text-3xl font-bold text-gray-900 mb-2">Restaurants by City</h1>
					<p class="text-lg text-gray-700 mb-2">
						Choose a city to see restaurants available for delivery with {SITE_TITLE}.
					</p>
				</header>

				{cities.length === 0 ? (
					<p class="text-gray-600">No cities found yet.</p>
				) : (
					<div class="row flex flex-wrap -mx-3">
						{cities.map((city) => (
							<div class="w-full md:w-1/2 px-3 mb-3" key={city.city_slug}>
								<ResponsiveFlexRow card align="stretch" variant="city">
									<div class="flex-1 flex flex-col">
										<h2 class="text-lg font-semibold mb-2">
											<a 
												href={`/restaurants/${city.city_slug}`} 
												class="text-white no-underline hover:text-blue-400 text-left bg-transparent border-none p-0 cursor-pointer transition-colors"
											>
												Restaurants in {city.city_name}, California
											</a>
										</h2>
									</div>
								</ResponsiveFlexRow>
							</div>
						))}
					</div>
				)}
			</main>
		</div>
		
		<!-- SPA container - wrapper checks auth before rendering App -->
		<div id="spa-container" style="display: none;">
			<SSRAppWrapper client:only="react" />
		</div>
		
		<Footer />
		
		<!-- Client-side auth check -->
		<script>
			function checkAuthAndShowSPA() {
				const profile = localStorage.getItem('profile');
				const ssrContent = document.getElementById('ssr-content');
				const spaContainer = document.getElementById('spa-container');
				
				// SSR content is visible by default (good for SEO crawlers)
				// Only hide it if user is definitely logged in
				
				if (profile) {
					// User might be logged in - verify session first
					// Hide SSR and show SPA immediately to prevent flicker
					if (ssrContent) ssrContent.style.display = 'none';
					if (spaContainer) spaContainer.style.display = 'block';
					
					// Then verify session
					fetch('/api/session', {
						credentials: 'include'
					})
					.then(res => {
						if (res.status !== 200) {
							// Session invalid - show SSR (user sees SSR content)
							if (ssrContent) ssrContent.style.display = 'block';
							if (spaContainer) spaContainer.style.display = 'none';
						}
						// If session is valid, SSR stays hidden, SPA stays visible
					})
					.catch(err => {
						console.error('Error checking session:', err);
						// On error, show SSR (safer default)
						if (ssrContent) ssrContent.style.display = 'block';
						if (spaContainer) spaContainer.style.display = 'none';
					});
				} else {
					// No profile - SSR content is already visible (default state)
					// Just make sure SPA is hidden
					if (spaContainer) spaContainer.style.display = 'none';
					// SSR content doesn't need to be explicitly shown - it's visible by default
				}
			}
			
			// Check immediately on page load (before DOM fully renders)
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', checkAuthAndShowSPA);
			} else {
				checkAuthAndShowSPA();
			}
			
			// Listen for custom event dispatched after login
			window.addEventListener('profile-changed', () => {
				checkAuthAndShowSPA();
			});
		</script>
	</body>
</html>


